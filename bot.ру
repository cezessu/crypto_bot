# --- КЛАСС ДЛЯ РАБОТЫ С MEXC API ---
class MexcChecker:
    def __init__(self, api_key, api_secret):
        self.api_key = api_key
        self.api_secret = api_secret
        self.base_url = "https://api.mexc.com"

    def _sign(self, params):
        query = '&'.join([f"{k}={v}" for k, v in sorted(params.items())])
        signature = hmac.new(
            self.api_secret.encode('utf-8'),
            query.encode('utf-8'),
            hashlib.sha256
        ).hexdigest()
        return signature

    def _request(self, endpoint, params):
        timestamp = int(time.time() * 1000)
        params['timestamp'] = timestamp
        
        sign_params = params.copy()
        query_string = '&'.join([f"{k}={v}" for k, v in sorted(sign_params.items())])
        
        signature = hmac.new(
            self.api_secret.encode('utf-8'),
            query_string.encode('utf-8'),
            hashlib.sha256
        ).hexdigest()
        
        params['signature'] = signature
        
        headers = {'X-MEXC-APIKEY': self.api_key}
        url = f"{self.base_url}{endpoint}"
        
        print(f"\n🔍 ЗАПРОС К API:")
        print(f"📌 URL: {url}")
        print(f"📦 ПАРАМЕТРЫ: {params}")
        print(f"🔑 API KEY: {self.api_key[:10]}...{self.api_key[-4:]}")
        print(f"📋 ПОЛНЫЙ URL: {url}?{query_string}&signature={signature}")
        
        response = requests.get(url, headers=headers, params=params, timeout=10)
        
        print(f"📥 ОТВЕТ API: {response.status_code}")
        print(f"📄 ТЕКСТ: {response.text[:500]}")
        
        return response

