            'endTime': int(time.time() * 1000)
        }
        try:
            resp = self._request('/api/v3/rebate/affiliate/referral', params)
            if resp.status_code != 200:
                return False, f"Ошибка API MEXC: {resp.status_code}"
            
            data = resp.json()
            
            if data.get('code') != 200:
                return False, f"Ошибка MEXC: {data.get('msg', 'Неизвестная ошибка')}"
            
            referrals = data.get('data', {}).get('resultList', [])
            
            if not referrals:
                return False, "❌ Вы не зарегистрированы по реферальной ссылке."
            
            ref = referrals[0]
            deposit = ref.get('firstDeposit', 0)
            trade_time = ref.get('tradeTime')
            
            if deposit is None or deposit < 100:
                return False, f"❌ Пополните счёт от 100 USDT. Сейчас: {deposit or 0} USDT"
            if trade_time is None:
                return False, "❌ Вы пополнили счёт, но ещё не совершили ни одной сделки."
            
            return True, f"✅ Всё готово! Депозит: {deposit} USDT, сделка совершена."
        except Exception as e:
            return False, f"Техническая ошибка: {str(e)}"

